[Unit]
Description=Rig Supervisor - Antminer vizhutes felugyelet
# Szandekosan nem var a halozatra: aramszunet utan a szivattyuknak minel elobb indulniuk kell.
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=rigsup
Group=rigsup
WorkingDirectory=/opt/rig-supervisor
ExecStart=/usr/bin/python3 -m rig_supervisor --data /var/lib/rig-supervisor --port @PORT@
Restart=always
RestartSec=3
# 1024 alatti port (pl. 80) hasznalatahoz root jog nelkul
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=PYTHONUNBUFFERED=1
# az lgpio konyvtar ide irhatja a sajat ertesito fajljait
Environment=LG_WD=/var/lib/rig-supervisor
# Leallitaskor a GPIO kimenetek (szivattyuk) allapota NEM valtozik meg.
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
